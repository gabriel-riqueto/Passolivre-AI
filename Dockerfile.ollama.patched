FROM golang:1.26.10-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git build-essential pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone --depth 1 --branch v0.40.16 \
    https://github.com/ollama/ollama.git .

RUN go get golang.org/x/net@v0.62.0 && \
    go mod tidy && \
    CGO_ENABLED=1 go build -trimpath -o /out/ollama .



FROM ollama/ollama:0.40.16 AS ollama-cpu

RUN rm -rf /usr/lib/ollama/cuda* \
    /usr/lib/ollama/rocm* \
    /usr/lib/ollama/vulkan* \
    /usr/lib/ollama/mlx*



FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 libgomp1 libopenblas0 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/ollama /usr/bin/ollama
COPY --from=ollama-cpu /usr/lib/ollama /usr/lib/ollama

ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_MODELS=/opt/ollama-models
ENV OLLAMA_KEEP_ALIVE=1m
ENV OLLAMA_NUM_PARALLEL=1

RUN groupadd --gid 10001 ollama && \
    useradd --uid 10001 --gid ollama --create-home ollama && \
    mkdir -p /opt/ollama-models && \
    chown -R ollama:ollama /opt/ollama-models

ENV HOME=/home/ollama

USER ollama

RUN set -eu; \
    ollama serve >/tmp/ollama-build.log 2>&1 & \
    pid=$!; \
    for i in $(seq 1 30); do \
      if ollama list >/dev/null 2>&1; then break; fi; \
      sleep 1; \
    done; \
    ollama pull qwen2.5:3b-instruct-q4_K_M; \
    kill "$pid" || true

EXPOSE 11434

ENTRYPOINT ["/usr/bin/ollama"]

CMD ["serve"]